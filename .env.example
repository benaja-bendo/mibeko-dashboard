APP_NAME=Mibeko
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
MIBEKO_API_HOST=api.mibeko.fr
MIBEKO_FRONT_HOST=app.mibeko.fr

# Documentation API (Scramble, /docs/api)
# Version affichée dans la documentation.
API_VERSION=v1
# Identifiants HTTP Basic protégeant /docs/api. Renseignez-les pour exposer la
# documentation en production ; laissés vides, l'accès est bloqué hors local.
API_DOCS_USERNAME=
API_DOCS_PASSWORD=

# Site vitrine public (mibeko.fr) — base des liens canoniques des pages de partage.
SITE_URL=https://mibeko.fr

NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

# AI Providers
AI_PROVIDER=mistral
AI_PROVIDER_EMBEDDINGS=mistral
# Failover de l'assistant : chaîne ORDONNÉE de fournisseurs (1er = principal,
# bascule sur le suivant en cas de rate-limit/surcharge). Vide = seul AI_PROVIDER.
# Attention à la résidence des données. Ex : "mistral,openai".
AI_ASSISTANT_FAILOVER=
# Quotas assistant IA (requêtes / minute et / jour, cf. config/ai.php)
AI_QUOTA_STANDARD_PER_MINUTE=20
AI_QUOTA_STANDARD_PER_DAY=200
AI_QUOTA_PREMIUM_PER_MINUTE=60
AI_QUOTA_PREMIUM_PER_DAY=1000
AI_QUOTA_ADMIN_PER_DAY=2000
#AI_MODEL="mistral-medium-2508" # "qwen3:0.6b"
#AI_MODEL="qwen2.5-coder:1.5b"
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=https://ollama.strea.benaja-bendo.fr
OLLAMA_API_KEY=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=mibeko-db
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS="hello@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mibeko-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

BACKUP_ENABLE_S3=true
BACKUP_ENABLE_GDRIVE=false

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_TEAM_DRIVE_ID=
GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=false
GOOGLE_DRIVE_USE_DISPLAY_PATHS=true
GOOGLE_DRIVE_QUOTA_USER=

# MinIO Buckets
MINIO_BUCKET_SOURCE=mibeko-documents
MINIO_BUCKET_DEST=mibeko-documents

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSockets)
REVERB_APP_ID=229289
REVERB_APP_KEY=shg62qdm61dsnvyzmzpy
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Firebase (FCM HTTP v1)
FIREBASE_PROJECT_ID=mibeko-mobile-34c01
FIREBASE_CREDENTIALS_PATH=storage/app/mibeko-mobile-34c01-firebase-adminsdk-fbsvc-570bc4918b.json
FIREBASE_URL=https://fcm.googleapis.com/v1/projects/{$FIREBASE_PROJECT_ID}/messages:send

# Stripe / Cashier (facturation). Laisser vide désactive le paiement en ligne.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=fr_CD
# Price IDs Stripe des formules (cf. config/billing.php)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# mineru
MINERU_API_URL="https://mineru.net/api/v4"
MINERU_API_KEY=""
MINERU_TIMEOUT=30

# ---------------------------------------------------------------------------
# Diagnostic de la PRODUCTION en lecture seule (tunnel SSH)
# ---------------------------------------------------------------------------
# Ces variables alimentent la connexion nommée « pgsql_prod_ro » et le disque
# « s3_prod_ro ». Elles ne changent RIEN au fonctionnement de l'application :
# ni le scheduler, ni les jobs, ni les serveurs MCP ne les utilisent. Le
# diagnostic s'invoque explicitement : php artisan mibeko:prod-preflight
#
# Prérequis côté serveur : un rôle Postgres dédié en lecture seule et un
# service account MinIO en policy readonly (cf. docs/infra/acces-prod-diagnostic.md).
#
# Ouvrir le tunnel avant usage :
#   ssh -N -L 5434:127.0.0.1:5432 -L 9100:127.0.0.1:9000 ubuntu@<IP_VPS>
#
# Les ports 5434 et 9100 sont volontairement différents de ceux du
# développement (5433 et 9000) : une prod indiscernable du dev est le
# scénario d'accident à éviter.
PROD_RO_DB_HOST=127.0.0.1
PROD_RO_DB_PORT=5434
PROD_RO_DB_DATABASE=
PROD_RO_DB_USERNAME=
PROD_RO_DB_PASSWORD=

PROD_RO_AWS_ACCESS_KEY_ID=
PROD_RO_AWS_SECRET_ACCESS_KEY=
PROD_RO_AWS_BUCKET=mibeko-documents
PROD_RO_AWS_ENDPOINT=http://127.0.0.1:9100

# ATTENTION — les variables d'ÉCRITURE en production (PROD_RW_DB_HOST,
# PROD_RW_DB_PORT, PROD_RW_DB_DATABASE, PROD_RW_DB_USERNAME,
# PROD_RW_DB_PASSWORD) ne doivent JAMAIS être renseignées dans un fichier,
# ici comme ailleurs. Elles s'exportent à la main dans le shell, pour une
# opération unique explicitement autorisée, puis se retirent aussitôt.
