<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Le CLI PHP local tourne avec le memory_limit par défaut (128M), pas assez
            pour un run complet dans un seul process (aucun isolation par test) : ça
            plante en pratique dans des tests qui allouent lourd (export PDF dompdf).
            La CI GitHub Actions ne voit jamais ce plantage car elle force déjà
            memory_limit=512M via setup-php (ini-values) ; cette ligne aligne le local
            sur la même valeur pour que `php artisan test` marche pareil partout,
            sans toucher au php.ini système.
        -->
        <ini name="memory_limit" value="512M" />
        <env name="APP_ENV" value="testing" />
        <env name="APP_MAINTENANCE_DRIVER" value="file" />
        <env name="BCRYPT_ROUNDS" value="4" />
        <env name="BROADCAST_CONNECTION" value="null" />
        <env name="CACHE_STORE" value="array" />
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <!--
            La cible des tests est épinglée ICI, jamais héritée du .env : la suite
            utilise RefreshDatabase, qui migre et vide la base visée. Sans l'hôte et
            le port fixés, un .env pointant la production (tunnel SSH) suffirait à
            faire migrer la production au premier `php artisan test`.
            127.0.0.1:5433 = Postgres de développement (docker-compose.local.yml).
        -->
        <env name="DB_CONNECTION" value="pgsql" />
        <env name="DB_HOST" value="127.0.0.1" />
        <env name="DB_PORT" value="5433" />
        <env name="DB_DATABASE" value="mibeko_testing" />
        <env name="DB_USERNAME" value="root" />
        <env name="DB_PASSWORD" value="root" />
        <!-- Le stockage objet des tests reste local : jamais le MinIO de production. -->
        <env name="FILESYSTEM_DISK" value="local" />
        <env name="MAIL_MAILER" value="array" />
        <env name="QUEUE_CONNECTION" value="sync" />
        <env name="SESSION_DRIVER" value="array" />
        <env name="PULSE_ENABLED" value="false" />
        <env name="TELESCOPE_ENABLED" value="false" />
        <env name="NIGHTWATCH_ENABLED" value="false" />
    </php>
</phpunit>
